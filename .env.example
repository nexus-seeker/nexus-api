# =============================================================================
# kawula-api — Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus

# ── Solana ────────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
NEXUS_PROGRAM_ID=DxV7vXf919YddC74X726PpsrPpHLXNZtdBsk6Lweh3HJ

# ── Chat LLM ──────────────────────────────────────────────────────────────────
# Supported providers: openai | deepseek
LLM_PROVIDER=deepseek
LLM_API_KEY=your-deepseek-or-openai-key
LLM_MODEL=deepseek-chat
# For OpenAI:  LLM_MODEL=gpt-4o-mini

# ── Embedding Model (for semantic memory / vector search) ─────────────────────
# These are SEPARATE from the chat LLM — you can mix providers freely.
# e.g. use DeepSeek for chat + OpenAI for embeddings.
#
# Required for semantic memory. Leave blank to disable semantic memory gracefully.
EMBEDDING_API_KEY=your-openai-key-for-embeddings
EMBEDDING_MODEL=text-embedding-3-small
# Optional: point at any OpenAI-compatible embedding endpoint
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# ── Jupiter (Swap routing) ────────────────────────────────────────────────────
JUPITER_API_URL=https://api.jup.ag/swap/v1
JUPITER_API_KEY=your-jupiter-api-key
JUPITER_ONLY_DIRECT_ROUTES=true
JUPITER_MAX_ACCOUNTS=32

# ── Raydium (Alternative swap routing) ───────────────────────────────────────
# Mainnet: https://transaction-v1.raydium.io
# Devnet:  https://api-v3.raydium.io
RAYDIUM_SWAP_HOST=https://api-v3.raydium.io
RAYDIUM_QUOTE_HOST=https://quote-api.raydium.io
ROUTE_SELECTOR_TIMEOUT_MS=3000

# ── On-chain Data ─────────────────────────────────────────────────────────────
HELIUS_API_KEY=your-helius-api-key
BIRDEYE_API_KEY=your-birdeye-api-key

# ── Push Notifications (optional) ────────────────────────────────────────────
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ── API Security ──────────────────────────────────────────────────────────────
API_KEY=nexus-hackathon-key
PORT=3001
