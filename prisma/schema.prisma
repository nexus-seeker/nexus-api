generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RunEvent {
  id        String   @id @default(cuid())
  runId     String
  seq       Int
  pubkey    String
  eventType String
  payload   Json
  createdAt DateTime @default(now())

  @@unique([runId, seq])
  @@map("run_events")
}

model AgentRun {
  runId          String                @id
  pubkey         String
  status         String
  intent         String?
  latestStep     Json?
  completedAt    DateTime?
  rejectedReason String?
  lastEventSeq   Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  messages       ConversationMessage[]

  @@index([pubkey, updatedAt])
  @@map("agent_runs")
}

model ConversationMessage {
  id        String   @id @default(cuid())
  runId     String
  pubkey    String
  seq       Int
  role      String
  content   String
  payload   Json?
  eventAt   DateTime
  createdAt DateTime @default(now())
  agentRun  AgentRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([pubkey, eventAt])
  @@index([pubkey, createdAt])
  @@map("conversation_messages")
}

model ReceiptCache {
  address        String   @id
  ownerPubkey    String
  agentProfile   String
  seekerId       String
  intentHash     Json
  protocol       String
  amountLamports BigInt
  txSignature    String
  status         String
  timestamp      Int
  bump           Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerPubkey, timestamp])
  @@index([ownerPubkey, updatedAt])
  @@map("receipts_cache")
}

model UserMemory {
  /// Solana wallet public key
  pubkey             String   @id
  /// Tokens the user frequently swaps (up to 10)
  preferredTokens    String[]
  /// Frequent recipient wallet addresses (up to 10)
  frequentRecipients String[]
  /// Rolling average trade size in SOL
  avgTradeSizeSol    Float    @default(0)
  /// Total number of agent runs
  runCount           Int      @default(0)
  /// Auto-updated on every write
  lastSeenAt         DateTime @updatedAt

  @@map("user_memory")
}
