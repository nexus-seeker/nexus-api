generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RunEvent {
  id        String   @id @default(cuid())
  runId     String
  seq       Int
  pubkey    String
  eventType String
  payload   Json
  createdAt DateTime @default(now())

  @@unique([runId, seq])
  @@map("run_events")
}
